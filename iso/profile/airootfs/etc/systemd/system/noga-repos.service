[Unit]
Description=Noga: prepara las bases de datos de repositorios
After=NetworkManager-wait-online.service pacman-init.service
Wants=NetworkManager-wait-online.service
ConditionPathExists=!/var/lib/pacman/sync/core.db

[Service]
Type=oneshot
ExecStart=/usr/local/bin/noga-repos
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
