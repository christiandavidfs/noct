#!/bin/sh
# Prepara snapshots y rollback en el sistema instalado, solo si la raíz es btrfs.
#
# Se ejecuta dentro del sistema destino (Calamares, shellprocess@cleanup) antes
# de que el paso del bootloader regenere GRUB, de modo que grub-btrfs pueda
# añadir las entradas de snapshots al menú.
set -eu

[ "$(stat -f -c %T / 2>/dev/null || true)" = "btrfs" ] || exit 0
command -v snapper >/dev/null 2>&1 || exit 0

snapper -c root create-config / >/dev/null 2>&1 || true
snapper -c root set-config \
  TIMELINE_LIMIT_HOURLY=5 \
  TIMELINE_LIMIT_DAILY=7 \
  TIMELINE_LIMIT_WEEKLY=0 \
  TIMELINE_LIMIT_MONTHLY=2 \
  TIMELINE_LIMIT_YEARLY=0 \
  NUMBER_LIMIT=20 \
  NUMBER_LIMIT_IMPORTANT=10 >/dev/null 2>&1 || true

systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true
systemctl enable grub-btrfsd.service >/dev/null 2>&1 || true

exit 0
